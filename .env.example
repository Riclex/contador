# Required
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/contador
OPENAI_API_KEY=sk-...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# Optional (strongly recommended for production)
WEBHOOK_URL=https://your-domain.com/webhook
ADMIN_NUMBERS=whatsapp:+244XXXXXXXXX,whatsapp:+351XXXXXXXXX
PORT=3000
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Data storage location shown in the /privacidade reply and full privacy policy.
# Set to the accurate region once verified (e.g. "na União Europeia (Frankfurt/Zurique)").
# If unset, the privacy statement is region-agnostic (Lei 22/11 compliance) and
# avoids asserting a location the deployment may not actually use.
DATA_STORAGE_LOCATION=

# Public URL of the ~45s tutorial video. If set, a "Como funciona (1 min)" line
# is shown in the first-run welcome and /ajuda; if unset, the line is omitted
# (no dead link). Set it after uploading the video (e.g. YouTube unlisted).
TUTORIAL_VIDEO_URL=